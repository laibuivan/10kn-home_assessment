# Optional. docker-compose.yml already has working defaults for local dev —
# copy this to `.env` only if you want to override one of them.

DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=device_console

# Host-side port bindings only (internal container ports are unaffected) —
# change these if 3010/5433 also collide with something else on your machine.
API_HOST_PORT=3010
DATABASE_HOST_PORT=5433
